PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/physiocare
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
CORS_ORIGIN=

# --- เชื่อมต่อระบบโรงพยาบาล (ไม่บังคับ) ดู docs/INTEGRATION.md ---
