# คัดลอกเป็น .env แล้วแก้ทุกค่า — ห้าม commit ไฟล์ .env
# โดเมนที่ชี้ DNS (A record) มาที่เซิร์ฟเวอร์นี้ (ใช้ localhost เพื่อทดสอบในเครื่อง)
DOMAIN=physio.example.co.th

# สร้างด้วย: openssl rand -hex 32   (ใช้ตัวอักษร hex เพื่อไม่ต้อง encode ใน URL)
POSTGRES_PASSWORD=
JWT_SECRET=

JWT_EXPIRES_IN=8h
MAX_UPLOAD_MB=5
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=02
